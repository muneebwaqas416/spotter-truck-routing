# Copy to .env for local development. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Comma-separated frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Set to 1 when deployed behind a single reverse proxy (Render, Railway)
NUM_PROXIES=0

# Redis cache (shared provider cache + throttle counters). Leave empty to use an in-process cache.
# Local Redis: see "Redis cache" in the README, then REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# HERE (routing + geocoding): https://developer.here.com
HERE_API_KEY=

# Outbound HTTP timeouts (seconds)
HTTP_CONNECT_TIMEOUT_S=3
HTTP_READ_TIMEOUT_S=10

# DRF throttle rates per client IP
THROTTLE_ANALYZE_RATE=20/min
THROTTLE_HEATMAP_RATE=20/min
THROTTLE_GEOCODE_RATE=120/min
